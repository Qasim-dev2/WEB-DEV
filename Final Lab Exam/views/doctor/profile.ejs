<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>My Profile — Multisensa Doctor</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
    <link rel="stylesheet" href="/css/style.css"/>
    <style>
        :root { --doc-primary:#1e40af; --doc-accent:#3b82f6; --doc-light:#eff6ff; }
        body { background:#f0f4ff; font-family:'Segoe UI',sans-serif; }
        .profile-hero { background:linear-gradient(135deg,#1e3a8a,#1e40af 60%,#3b82f6); color:#fff; padding:3rem 0 5rem; border-radius:0 0 40px 40px; }
        .profile-card { border:none; border-radius:20px; background:#fff; box-shadow:0 4px 24px rgba(30,64,175,.1); }
        .info-row { padding:.75rem 0; border-bottom:1px solid #f1f5f9; display:flex; align-items:center; gap:12px; }
        .info-row:last-child { border-bottom:none; }
        .info-icon { width:36px;height:36px;border-radius:10px;background:#eff6ff;color:var(--doc-primary);display:flex;align-items:center;justify-content:center;flex-shrink:0; }
        .avail-badge { display:inline-block;padding:5px 16px;border-radius:20px;font-size:.8rem;font-weight:600; }
        .avail-available { background:#dcfce7;color:#15803d; }
        .avail-limited   { background:#fef9c3;color:#854d0e; }
        .avail-full      { background:#ffe4e6;color:#be123c; }
    </style>
</head>
<body>

<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<!-- HERO -->
<div class="profile-hero">
    <div class="container text-center">
        <% const img = doctor.image && doctor.image.trim()
               ? (doctor.image.startsWith('http') ? doctor.image : '/uploads/doctors/' + doctor.image)
               : null; %>
        <% if (img) { %>
        <img src="<%= img %>" alt="<%= doctor.name %>"
             style="width:100px;height:100px;border-radius:50%;object-fit:cover;border:4px solid rgba(255,255,255,.6);margin-bottom:1rem;"
             onerror="this.onerror=null;this.style.display='none';this.nextElementSibling.style.display='flex'">
        <div style="width:100px;height:100px;border-radius:50%;background:rgba(255,255,255,.2);border:4px solid rgba(255,255,255,.5);display:none;align-items:center;justify-content:center;font-size:2.5rem;font-weight:700;color:#fff;margin:0 auto 1rem;">
            <%= doctor.name.charAt(0).toUpperCase() %>
        </div>
        <% } else { %>
        <div style="width:100px;height:100px;border-radius:50%;background:rgba(255,255,255,.2);border:4px solid rgba(255,255,255,.5);display:flex;align-items:center;justify-content:center;font-size:2.5rem;font-weight:700;color:#fff;margin:0 auto 1rem;">
            <%= doctor.name.charAt(0).toUpperCase() %>
        </div>
        <% } %>
        <h2 class="fw-bold mb-1"><%= doctor.name %></h2>
        <p class="opacity-80 mb-2"><%= doctor.category %></p>
        <span class="avail-badge avail-<%= doctor.availability === 'Available' ? 'available' : (doctor.availability === 'Fully Booked' ? 'full' : 'limited') %>">
            <%= doctor.availability %>
        </span>
    </div>
</div>

<div class="container py-4 pb-5">
    <div class="row justify-content-center g-4">
        <div class="col-lg-7">
            <div class="profile-card p-4 mb-4">
                <h6 class="fw-bold mb-3" style="color:var(--doc-primary);"><i class="fas fa-id-card me-2"></i>Professional Details</h6>
                <div class="info-row">
                    <div class="info-icon"><i class="fas fa-user-md"></i></div>
                    <div><div style="font-size:.72rem;color:#64748b;">Full Name</div><div class="fw-semibold"><%= doctor.name %></div></div>
                </div>
                <div class="info-row">
                    <div class="info-icon"><i class="fas fa-stethoscope"></i></div>
                    <div><div style="font-size:.72rem;color:#64748b;">Specialization</div><div class="fw-semibold"><%= doctor.category %></div></div>
                </div>
                <div class="info-row">
                    <div class="info-icon"><i class="fas fa-graduation-cap"></i></div>
                    <div><div style="font-size:.72rem;color:#64748b;">Qualification</div><div class="fw-semibold"><%= doctor.qualification %></div></div>
                </div>
                <div class="info-row">
                    <div class="info-icon"><i class="fas fa-briefcase-medical"></i></div>
                    <div><div style="font-size:.72rem;color:#64748b;">Experience</div><div class="fw-semibold"><%= doctor.experience %> Years</div></div>
                </div>
                <div class="info-row">
                    <div class="info-icon"><i class="fas fa-coins"></i></div>
                    <div><div style="font-size:.72rem;color:#64748b;">Consultation Fee</div><div class="fw-semibold">PKR <%= doctor.charges.toLocaleString() %></div></div>
                </div>
                <div class="info-row">
                    <div class="info-icon"><i class="fas fa-star"></i></div>
                    <div><div style="font-size:.72rem;color:#64748b;">Patient Rating</div><div class="fw-semibold"><%= doctor.rating.toFixed(1) %> / 5.0</div></div>
                </div>
            </div>

            <% if (doctor.description) { %>
            <div class="profile-card p-4 mb-4">
                <h6 class="fw-bold mb-3" style="color:var(--doc-primary);"><i class="fas fa-align-left me-2"></i>About Me</h6>
                <p class="mb-0 text-muted" style="line-height:1.8;"><%= doctor.description %></p>
            </div>
            <% } %>

            <div class="d-flex gap-2 flex-wrap">
                <a href="/doctors/<%= doctor._id %>" class="btn rounded-pill fw-semibold px-4" style="background:var(--doc-primary);color:#fff;">
                    <i class="fas fa-eye me-1"></i> View Public Profile
                </a>
                <a href="/doctor/dashboard" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
                </a>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <div class="profile-card p-4 mb-4 text-center">
                <i class="fas fa-envelope-circle-check fa-2x mb-2" style="color:var(--doc-primary);"></i>
                <h6 class="fw-bold mb-1">Account Email</h6>
                <p class="text-muted small mb-0"><%= currentUser.email %></p>
            </div>
            <div class="p-4 rounded-4 text-center" style="background:var(--doc-primary);color:#fff;">
                <i class="fas fa-headset fa-2x mb-2 opacity-90"></i>
                <h6 class="fw-bold mb-1">Need Profile Update?</h6>
                <p class="mb-3 opacity-80" style="font-size:.8rem;">Contact the clinic admin to update your professional profile details.</p>
                <a href="mailto:admin@multisensa.com" class="btn btn-sm btn-light rounded-pill fw-semibold px-4" style="font-size:.8rem;color:var(--doc-primary);">
                    <i class="fas fa-envelope me-1"></i> Contact Admin
                </a>
            </div>
        </div>
    </div>
</div>

<footer class="text-center py-4" style="background:#fff;border-top:1px solid #e2e8f0;">
    <p class="mb-0 text-muted small">&copy; <%= new Date().getFullYear() %> Multisensa Rehabilitation Center.</p>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
