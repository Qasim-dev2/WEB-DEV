<%# views/partials/navbar.ejs — Dynamic auth-aware navbar %>
<nav class="navbar navbar-expand-lg navbar-dark bg-teal sticky-top shadow-sm">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/">
      <i class="fa-solid fa-heart-pulse me-2"></i>Multisensa
    </a>
    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item"><a class="nav-link" href="/doctors"><i class="fa-solid fa-user-doctor me-1"></i>Specialists</a></li>
        <li class="nav-item">
          <a class="nav-link d-flex align-items-center gap-1" href="/onsale-doctors">
            <i class="fa-solid fa-tag"></i>
            <span>On Sale</span>
            <span class="badge bg-danger" style="font-size:.6rem;padding:2px 6px;border-radius:8px;">SALE</span>
          </a>
        </li>
        <% if (currentUser && (currentUser.role === 'patient' || currentUser.role === 'customer')) { %>
        <li class="nav-item"><a class="nav-link" href="/patient/dashboard"><i class="fa-solid fa-gauge me-1"></i>My Dashboard</a></li>
        <li class="nav-item"><a class="nav-link" href="/appointments/book"><i class="fa-solid fa-calendar-plus me-1"></i>Book Appointment</a></li>
        <% } %>
        <% if (currentUser && currentUser.role === 'doctor') { %>
        <li class="nav-item"><a class="nav-link" href="/doctor/dashboard"><i class="fa-solid fa-gauge me-1"></i>My Dashboard</a></li>
        <% } %>
        <% if (currentUser && currentUser.role === 'admin') { %>
        <li class="nav-item"><a class="nav-link" href="/admin"><i class="fa-solid fa-screwdriver-wrench me-1"></i>Admin Panel</a></li>
        <% } %>
      </ul>
      <ul class="navbar-nav ms-auto align-items-center gap-1">
        <% if (currentUser) { %>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" id="userDD" role="button" data-bs-toggle="dropdown">
            <span class="user-avatar-sm"><%= currentUser.name.charAt(0).toUpperCase() %></span>
            <span class="d-none d-md-inline"><%= currentUser.name %></span>
            <% if (currentUser.role === 'admin') { %><span class="badge bg-warning text-dark" style="font-size:.6rem">ADMIN</span><% } %>
          </a>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><div class="dropdown-header"><div class="fw-semibold"><%= currentUser.name %></div><small class="text-muted"><%= currentUser.email %></small></div></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item" href="/profile"><i class="fa-solid fa-circle-user me-2 text-teal"></i>My Profile</a></li>
            <% if (currentUser.role === 'admin') { %>
            <li><a class="dropdown-item" href="/admin"><i class="fa-solid fa-gauge-high me-2 text-teal"></i>Admin Dashboard</a></li>
            <li><a class="dropdown-item" href="/admin/appointments"><i class="fa-solid fa-calendar-check me-2 text-teal"></i>Appointments</a></li>
            <li><a class="dropdown-item" href="/admin/doctors"><i class="fa-solid fa-stethoscope me-2 text-teal"></i>Manage Doctors</a></li>
            <% } else if (currentUser.role === 'doctor') { %>
            <li><a class="dropdown-item" href="/doctor/dashboard"><i class="fa-solid fa-gauge me-2 text-teal"></i>My Dashboard</a></li>
            <li><a class="dropdown-item" href="/doctor/appointments"><i class="fa-solid fa-calendar-check me-2 text-teal"></i>My Appointments</a></li>
            <li><a class="dropdown-item" href="/doctor/profile"><i class="fa-solid fa-id-card me-2 text-teal"></i>My Doctor Profile</a></li>
            <% } else { %>
            <li><a class="dropdown-item" href="/patient/dashboard"><i class="fa-solid fa-gauge me-2 text-teal"></i>My Dashboard</a></li>
            <li><a class="dropdown-item" href="/appointments/book"><i class="fa-solid fa-calendar-plus me-2 text-teal"></i>Book Appointment</a></li>
            <% } %>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item text-danger" href="/logout"><i class="fa-solid fa-right-from-bracket me-2"></i>Logout</a></li>
          </ul>
        </li>
        <% } else { %>
        <li class="nav-item"><a class="nav-link px-3" href="/login"><i class="fa-solid fa-right-to-bracket me-1"></i>Login</a></li>
        <li class="nav-item"><a class="btn btn-outline-light btn-sm px-3" href="/register"><i class="fa-solid fa-user-plus me-1"></i>Register</a></li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>
