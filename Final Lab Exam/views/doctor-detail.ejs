<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= doctor.name %> — Multisensa Rehabilitation Center</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Site CSS (defines bg-teal and shared utilities) -->
    <link rel="stylesheet" href="/css/style.css">

    <style>
        *, *::before, *::after { box-sizing: border-box; }

        body {
            font-family: 'Inter', Arial, sans-serif;
            background: #f0fdf9;
            color: #1f2937;
        }

        /* ── NAVBAR ── */
        .site-navbar {
            background: #fff;
            box-shadow: 0 2px 12px rgba(0,0,0,0.08);
            position: sticky; top: 0; z-index: 1000;
        }
        .site-navbar .navbar-brand {
            font-weight: 800; font-size: 1.15rem;
            color: #0f766e !important; text-decoration: none;
        }
        .site-navbar .nav-link {
            color: #374151 !important; font-weight: 500; font-size: 0.92rem;
            padding: 0.5rem 0.9rem !important; border-radius: 6px;
            transition: background 0.2s, color 0.2s;
        }
        .site-navbar .nav-link:hover { background: #f0fdf9; color: #0f766e !important; }
        .btn-nav-book {
            background: #0f766e !important; color: #fff !important;
            border-radius: 25px !important; padding: 0.42rem 1.2rem !important;
            font-weight: 600 !important; font-size: 0.88rem !important;
        }
        .btn-nav-book:hover { background: #065f46 !important; }

        /* ── BREADCRUMB ── */
        .breadcrumb-bar {
            background: #fff;
            border-bottom: 1px solid #e5e7eb;
            padding: 10px 0;
        }
        .breadcrumb { margin-bottom: 0; font-size: 0.85rem; }
        .breadcrumb-item a { color: #0f766e; text-decoration: none; }
        .breadcrumb-item a:hover { text-decoration: underline; }
        .breadcrumb-item.active { color: #6b7280; }
        .breadcrumb-item + .breadcrumb-item::before { color: #9ca3af; }

        /* ── PROFILE CARD (left column) ── */
        .profile-card {
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.09);
            overflow: hidden;
            position: sticky; top: 80px;
        }
        .profile-card-header {
            background: linear-gradient(135deg, #0f766e, #134e4a);
            padding: 36px 20px 24px;
            text-align: center;
            position: relative;
        }
        .profile-avatar {
            width: 130px; height: 130px;
            border-radius: 50%;
            object-fit: cover;
            border: 5px solid rgba(255,255,255,0.9);
            box-shadow: 0 8px 24px rgba(0,0,0,0.2);
            display: block; margin: 0 auto 14px;
        }
        .profile-name {
            color: #fff; font-size: 1.3rem; font-weight: 800;
            margin-bottom: 4px;
        }
        .profile-cat-badge {
            display: inline-block;
            font-size: 0.72rem; font-weight: 600;
            padding: 4px 12px; border-radius: 15px;
            color: #fff; margin-bottom: 10px;
        }
        .profile-rating {
            color: rgba(255,255,255,0.9); font-size: 0.85rem;
        }
        .profile-rating .fa-star, .profile-rating .fa-star-half-alt { color: #fbbf24; }
        .profile-rating .far.fa-star { color: rgba(255,255,255,0.4); }

        /* Availability inside profile header */
        .profile-avail {
            display: inline-flex; align-items: center; gap: 6px;
            font-size: 0.78rem; font-weight: 600;
            padding: 4px 12px; border-radius: 15px; margin-top: 8px;
        }
        .avail-available { background: #dcfce7; color: #15803d; }
        .avail-limited   { background: #fef3c7; color: #92400e; }
        .avail-booked    { background: #fee2e2; color: #991b1b; }

        .profile-card-body { padding: 1.4rem 1.5rem; }

        /* Stat chips inside profile card */
        .profile-stat-row {
            display: grid; grid-template-columns: 1fr 1fr;
            gap: 10px; margin-bottom: 1.2rem;
        }
        .profile-stat {
            background: #f0fdf9;
            border: 1px solid #a7f3d0;
            border-radius: 10px;
            padding: 10px 12px;
            text-align: center;
        }
        .profile-stat .stat-num {
            font-size: 1.2rem; font-weight: 800; color: #0f766e;
            display: block;
        }
        .profile-stat .stat-label {
            font-size: 0.7rem; color: #6b7280; margin-top: 2px;
        }

        /* CTA buttons */
        .btn-book-main {
            display: block; width: 100%;
            background: linear-gradient(135deg, #0f766e, #065f46);
            color: #fff; border: none; border-radius: 10px;
            font-weight: 700; font-size: 0.95rem;
            padding: 12px; text-decoration: none; text-align: center;
            transition: opacity 0.2s;
            margin-bottom: 10px;
        }
        .btn-book-main:hover { opacity: 0.9; color: #fff; }
        .btn-whatsapp {
            display: block; width: 100%;
            background: #25d366; color: #fff; border: none;
            border-radius: 10px; font-weight: 700; font-size: 0.9rem;
            padding: 10px; text-decoration: none; text-align: center;
            transition: opacity 0.2s;
        }
        .btn-whatsapp:hover { opacity: 0.88; color: #fff; }

        /* ── DETAIL CONTENT (right column) ── */
        .detail-section {
            background: #fff; border-radius: 14px;
            padding: 1.75rem; margin-bottom: 1.25rem;
            box-shadow: 0 2px 14px rgba(0,0,0,0.06);
        }
        .section-title {
            font-size: 1rem; font-weight: 700; color: #0f766e;
            border-left: 4px solid #0f766e; padding-left: 10px;
            margin-bottom: 1rem;
        }

        /* Info grid */
        .info-item {
            display: flex; align-items: flex-start; gap: 12px;
            background: #f8fafc; border-radius: 10px;
            padding: 14px; transition: box-shadow 0.2s;
        }
        .info-item:hover { box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
        .info-item .icon-box {
            width: 40px; height: 40px; border-radius: 10px;
            background: #f0fdf9; color: #0f766e;
            display: flex; align-items: center; justify-content: center;
            font-size: 1rem; flex-shrink: 0;
        }
        .info-item small { font-size: 0.72rem; color: #9ca3af; display: block; }
        .info-item strong { font-size: 0.9rem; color: #111827; font-weight: 600; }

        /* Charges highlight */
        .charges-highlight {
            background: linear-gradient(135deg, #f0fdf9, #d1fae5);
            border: 2px solid #6ee7b7;
            border-radius: 12px; padding: 1.2rem 1.5rem;
            display: flex; align-items: center; justify-content: space-between;
        }
        .charges-highlight .amount {
            font-size: 2rem; font-weight: 800; color: #0f766e;
        }
        .charges-highlight .per-session {
            font-size: 0.78rem; color: #6b7280;
        }

        /* Working hours */
        .hours-row {
            display: flex; align-items: center; gap: 10px;
            padding: 8px 0; border-bottom: 1px solid #f3f4f6;
            font-size: 0.88rem; color: #374151;
        }
        .hours-row:last-child { border-bottom: none; }
        .hours-row i { color: #0f766e; width: 18px; }
        .hours-badge {
            background: #dcfce7; color: #15803d;
            font-size: 0.7rem; font-weight: 600; padding: 2px 8px;
            border-radius: 10px; margin-left: auto;
        }

        /* ── RELATED DOCTORS ── */
        .related-section { margin-top: 3rem; }
        .related-title {
            font-size: 1.3rem; font-weight: 700; color: #111827; margin-bottom: 1.5rem;
        }
        .related-card {
            background: #fff; border-radius: 14px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.07);
            overflow: hidden; transition: transform 0.25s, box-shadow 0.25s;
            text-decoration: none; color: inherit; display: block;
        }
        .related-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 28px rgba(0,0,0,0.1);
            color: inherit;
        }
        .related-card-img {
            background: linear-gradient(135deg, #f0fdf9, #ccfbf1);
            padding: 20px; text-align: center;
        }
        .related-avatar {
            width: 72px; height: 72px; border-radius: 50%;
            border: 3px solid #fff; box-shadow: 0 3px 10px rgba(0,0,0,0.12);
        }
        .related-card-body { padding: 14px 16px; }
        .related-doc-name  { font-weight: 700; font-size: 0.92rem; margin-bottom: 2px; }
        .related-doc-exp   { font-size: 0.78rem; color: #6b7280; }
        .related-doc-fee   { font-size: 0.88rem; font-weight: 700; color: #0f766e; margin-top: 6px; }

        /* ── BACK BUTTON ── */
        .btn-back {
            display: inline-flex; align-items: center; gap: 8px;
            color: #6b7280; border: 1.5px solid #e5e7eb;
            border-radius: 8px; padding: 8px 18px;
            text-decoration: none; font-size: 0.88rem; font-weight: 600;
            transition: all 0.2s;
        }
        .btn-back:hover { border-color: #0f766e; color: #0f766e; }

        /* ── FOOTER ── */
        .site-footer {
            background: #134e4a; color: rgba(255,255,255,0.8);
            padding: 28px 0; margin-top: 60px; text-align: center;
        }
        .site-footer a { color: #5eead4; text-decoration: none; }
        .site-footer a:hover { color: #fff; }

        /* ── RESPONSIVE ── */
        @media (max-width: 991px) {
            .profile-card  { position: static; margin-bottom: 1.5rem; }
        }
    </style>
</head>
<body>

<%- include('partials/navbar') %>
<div class="container pt-2"><%- include('partials/flash') %></div>

<!-- =========================================================
     BREADCRUMB
========================================================= -->
<div class="breadcrumb-bar">
    <div class="container">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/"><i class="fas fa-home me-1"></i>Home</a></li>
            <li class="breadcrumb-item"><a href="/doctors">Our Specialists</a></li>
            <li class="breadcrumb-item active"><%= doctor.name %></li>
        </ol>
    </div>
</div>

<!-- =========================================================
     MAIN CONTENT
========================================================= -->
<div class="container my-5">
    <div class="row g-4">

        <!-- =====================================================
             LEFT COLUMN — Profile Card
        ===================================================== -->
        <div class="col-lg-4">
            <div class="profile-card">

                <!-- Card header (gradient background with avatar) -->
                <div class="profile-card-header">
                    <%
                        var catColors2 = {
                            'Physiotherapist':          '#0d9488',
                            'Psychologist':             '#7c3aed',
                            'Orthopedic Specialist':    '#dc2626',
                            'Neurologist':              '#ea580c',
                            'Occupational Therapist':   '#059669',
                            'Speech Therapist':         '#0284c7',
                            'Rehabilitation Consultant':'#b45309'
                        };
                        var profileCatColor = catColors2[doctor.category] || '#6c757d';

                        var fs2 = Math.floor(doctor.rating);
                        var hh2 = (doctor.rating % 1) >= 0.5;
                        var es2 = 5 - fs2 - (hh2 ? 1 : 0);

                        var availClass2 = doctor.availability === 'Available'     ? 'avail-available' :
                                          doctor.availability === 'Limited Slots' ? 'avail-limited'   :
                                                                                    'avail-booked';
                    %>
                    <img
                        src="<%= doctor.image %>"
                        alt="<%= doctor.name %>"
                        class="profile-avatar"
                        onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(doctor.name) %>&background=0f766e&color=fff&size=200&bold=true&rounded=true'"
                    >
                    <h2 class="profile-name"><%= doctor.name %></h2>
                    <span class="profile-cat-badge" style="background-color:<%= profileCatColor %>;">
                        <%= doctor.category %>
                    </span>
                    <div class="profile-rating">
                        <% for (var s = 0; s < fs2;  s++) { %><i class="fas fa-star"></i><% } %>
                        <% if (hh2)                          { %><i class="fas fa-star-half-alt"></i><% } %>
                        <% for (var s = 0; s < es2;  s++) { %><i class="far fa-star"></i><% } %>
                        <span class="ms-1"><%= doctor.rating.toFixed(1) %> / 5.0 Patient Rating</span>
                    </div>
                    <div>
                        <span class="profile-avail <%= availClass2 %>">
                            <% if (doctor.availability === 'Available') { %>
                                <i class="fas fa-circle" style="font-size:7px;"></i>
                            <% } else if (doctor.availability === 'Limited Slots') { %>
                                <i class="fas fa-clock" style="font-size:9px;"></i>
                            <% } else { %>
                                <i class="fas fa-times-circle" style="font-size:9px;"></i>
                            <% } %>
                            <%= doctor.availability %>
                        </span>
                    </div>
                </div>

                <!-- Card body with stat chips and CTA -->
                <div class="profile-card-body">
                    <div class="profile-stat-row">
                        <div class="profile-stat">
                            <span class="stat-num"><%= doctor.experience %>+</span>
                            <span class="stat-label">Years Exp.</span>
                        </div>
                        <div class="profile-stat">
                            <span class="stat-num"><%= doctor.rating.toFixed(1) %></span>
                            <span class="stat-label">Patient Rating</span>
                        </div>
                    </div>

                    <!-- Book Appointment button -->
                    <a href="/appointments/book?doctor=<%= doctor._id %>" class="btn-book-main">
                        <i class="fas fa-calendar-plus me-2"></i> Book Appointment
                    </a>

                    <!-- WhatsApp button -->
                    <a href="https://wa.me/923147367769" class="btn-whatsapp" target="_blank" rel="noopener noreferrer">
                        <i class="fab fa-whatsapp me-2"></i> Chat on WhatsApp
                    </a>
                </div>
            </div>
        </div>
        <!-- END LEFT COLUMN -->

        <!-- =====================================================
             RIGHT COLUMN — Details
        ===================================================== -->
        <div class="col-lg-8">

            <!-- ── About Section ── -->
            <div class="detail-section">
                <h4 class="section-title">About the Specialist</h4>
                <p style="font-size:0.95rem; line-height:1.75; color:#374151;">
                    <%= doctor.description %>
                </p>
                <p style="font-size:0.9rem; color:#6b7280; margin-bottom:0;">
                    <i class="fas fa-map-marker-alt me-2 text-success"></i>
                    477 Nishtar Block, Allama Iqbal Town, Lahore
                </p>
            </div>

            <!-- ── Info Grid ── -->
            <div class="detail-section">
                <h4 class="section-title">Specialist Information</h4>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="info-item">
                            <div class="icon-box"><i class="fas fa-stethoscope"></i></div>
                            <div>
                                <small>Specialization</small>
                                <strong><%= doctor.category %></strong>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-item">
                            <div class="icon-box"><i class="fas fa-briefcase"></i></div>
                            <div>
                                <small>Experience</small>
                                <strong><%= doctor.experience %> Years</strong>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-item">
                            <div class="icon-box"><i class="fas fa-graduation-cap"></i></div>
                            <div>
                                <small>Qualification</small>
                                <strong><%= doctor.qualification %></strong>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-item">
                            <div class="icon-box"><i class="fas fa-star"></i></div>
                            <div>
                                <small>Patient Rating</small>
                                <strong><%= doctor.rating.toFixed(1) %> out of 5.0</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── Consultation Charges ── -->
            <div class="detail-section">
                <h4 class="section-title">Consultation Fee</h4>
                <div class="charges-highlight">
                    <div>
                        <div class="amount">PKR <%= doctor.charges.toLocaleString() %></div>
                        <div class="per-session">per consultation session</div>
                    </div>
                    <div style="text-align:right;">
                        <i class="fas fa-coins" style="font-size:2.5rem; color:#f59e0b; opacity:0.6;"></i>
                    </div>
                </div>
                <p class="mt-3 mb-0" style="font-size:0.82rem; color:#9ca3af;">
                    <i class="fas fa-info-circle me-1"></i>
                    Consultation fees are subject to change. Please confirm at the time of booking.
                </p>
            </div>

            <!-- ── Working Hours & Availability ── -->
            <div class="detail-section">
                <h4 class="section-title">Schedule & Availability</h4>
                <div class="hours-row">
                    <i class="fas fa-calendar-day"></i>
                    <span>Monday — Saturday</span>
                    <span class="hours-badge"><i class="fas fa-check me-1"></i>Open</span>
                    <span class="ms-2" style="color:#0f766e; font-weight:600;">3:00 PM – 7:00 PM</span>
                </div>
                <div class="hours-row">
                    <i class="fas fa-calendar-times"></i>
                    <span>Sunday</span>
                    <span class="ms-auto" style="font-size:0.82rem; color:#6b7280;">By appointment only</span>
                </div>
                <div class="mt-3 p-3 rounded"
                     style="background:<%= doctor.availability === 'Available' ? '#f0fdf4' : doctor.availability === 'Limited Slots' ? '#fffbeb' : '#fff1f2' %>; border-radius:10px;">
                    <p class="mb-0" style="font-size:0.88rem; font-weight:600;
                               color:<%= doctor.availability === 'Available' ? '#15803d' : doctor.availability === 'Limited Slots' ? '#92400e' : '#991b1b' %>;">
                        <i class="fas <%= doctor.availability === 'Available' ? 'fa-circle-check' : doctor.availability === 'Limited Slots' ? 'fa-clock' : 'fa-ban' %> me-2"></i>
                        Current Status: <%= doctor.availability %>
                        <% if (doctor.availability === 'Available') { %>
                            — Appointments are open for booking.
                        <% } else if (doctor.availability === 'Limited Slots') { %>
                            — Very few slots remaining. Book quickly!
                        <% } else { %>
                            — All slots are currently full. Please check back later.
                        <% } %>
                    </p>
                </div>
            </div>

        </div>
        <!-- END RIGHT COLUMN -->

    </div>
    <!-- end row -->

    <!-- =====================================================
         RELATED DOCTORS
    ===================================================== -->
    <% if (relatedDoctors.length > 0) { %>
    <div class="related-section">
        <h3 class="related-title">
            <i class="fas fa-users me-2" style="color:#0f766e;"></i>
            Other <%= doctor.category %>s at Multisensa
        </h3>
        <div class="row g-4">
            <% relatedDoctors.forEach(function(rd) { %>
            <%
                var rdCatColor = catColors2[rd.category] || '#6c757d';
                var rdFs = Math.floor(rd.rating);
                var rdHh = (rd.rating % 1) >= 0.5;
                var rdEs = 5 - rdFs - (rdHh ? 1 : 0);
            %>
            <div class="col-md-4">
                <a href="/doctors/<%= rd._id %>" class="related-card">
                    <div class="related-card-img">
                        <img
                            src="<%= rd.image %>"
                            alt="<%= rd.name %>"
                            class="related-avatar"
                            onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(rd.name) %>&background=0f766e&color=fff&size=100&bold=true&rounded=true'"
                        >
                    </div>
                    <div class="related-card-body">
                        <div class="related-doc-name"><%= rd.name %></div>
                        <div style="font-size:0.75rem; margin-bottom:4px;">
                            <% for (var s = 0; s < rdFs;  s++) { %><i class="fas fa-star" style="color:#f59e0b; font-size:0.7rem;"></i><% } %>
                            <% if (rdHh) { %><i class="fas fa-star-half-alt" style="color:#f59e0b; font-size:0.7rem;"></i><% } %>
                            <% for (var s = 0; s < rdEs;  s++) { %><i class="far fa-star" style="color:#d1d5db; font-size:0.7rem;"></i><% } %>
                            <span style="color:#9ca3af; font-size:0.7rem; margin-left:3px;"><%= rd.rating.toFixed(1) %></span>
                        </div>
                        <div class="related-doc-exp">
                            <i class="fas fa-briefcase me-1" style="color:#0f766e;"></i><%= rd.experience %> yrs exp &nbsp;|&nbsp;
                            <i class="fas fa-graduation-cap me-1" style="color:#0f766e;"></i><%= rd.qualification %>
                        </div>
                        <div class="related-doc-fee">PKR <%= rd.charges.toLocaleString() %> / session</div>
                    </div>
                </a>
            </div>
            <% }) %>
        </div>
    </div>
    <% } %>

    <!-- Back button -->
    <div class="mt-5">
        <a href="/doctors" class="btn-back">
            <i class="fas fa-arrow-left"></i> Back to All Specialists
        </a>
    </div>

</div>
<!-- end container -->

<!-- =========================================================
     FOOTER
========================================================= -->
<footer class="site-footer">
    <div class="container">
        <p class="mb-1">
            <i class="fas fa-heartbeat me-2 text-danger"></i>
            <strong>Multisensa Rehabilitation Center</strong>
        </p>
        <p class="mb-0" style="font-size:0.85rem;">
            477 Nishtar Block, Allama Iqbal Town, Lahore
            &nbsp;|&nbsp;
            <a href="tel:+923147367769">+92 314 736 7769</a>
            &nbsp;|&nbsp;
            <a href="/doctors">← All Specialists</a>
        </p>
    </div>
</footer>

<!-- Bootstrap 5 JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
