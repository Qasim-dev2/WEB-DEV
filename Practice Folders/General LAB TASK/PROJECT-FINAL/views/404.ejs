<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Page Not Found – Multisensa</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/navbar') %>
  <div class="d-flex align-items-center justify-content-center" style="min-height: calc(100vh - 70px);">
    <div class="text-center px-3">
      <div style="font-size: 7rem; color: var(--teal); line-height: 1;" class="mb-3">
        <i class="fa-solid fa-triangle-exclamation"></i>
      </div>
      <h1 class="display-1 fw-bold text-dark">404</h1>
      <h4 class="text-muted mb-2">Page Not Found</h4>
      <p class="text-muted mb-4">
        The page <code><%= url %></code> could not be found.
      </p>
      <div class="d-flex gap-3 justify-content-center">
        <a href="/" class="btn btn-teal px-4">
          <i class="fa-solid fa-house me-2"></i>Go Home
        </a>
        <a href="/doctors" class="btn btn-outline-teal px-4">
          <i class="fa-solid fa-user-doctor me-2"></i>View Specialists
        </a>
      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
