<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Appointment — Multisensa Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <link href="/css/admin.css" rel="stylesheet">
  <style>
    .section-label {
      font-size: .7rem;
      font-weight: 700;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: #9ca3af;
      margin-bottom: .5rem;
    }
    .form-control:focus, .form-select:focus {
      border-color: #0d9488;
      box-shadow: 0 0 0 3px rgba(13,148,136,.12);
    }
    .status-opt-pending   { color: #92400e; }
    .status-opt-approved  { color: #065f46; }
    .status-opt-rejected  { color: #991b1b; }
    .status-opt-completed { color: #134e4a; }
    .status-opt-cancelled { color: #374151; }
  </style>
</head>
<body class="admin-body">

<%- include('partials/sidebar', { activePage: 'appointments' }) %>

<div class="admin-main">

  <!-- ── Top Bar ── -->
  <div class="admin-topbar">
    <div class="topbar-left">
      <button class="sidebar-toggle-btn" id="sidebarToggle"><i class="fas fa-bars"></i></button>
      <div class="topbar-page-title">
        <h4><i class="fas fa-calendar-plus me-2" style="color:#0d9488"></i>Create Appointment</h4>
        <small>Book an appointment on behalf of a patient</small>
      </div>
    </div>
    <div class="topbar-right">
      <span class="admin-role-badge"><i class="fas fa-shield-alt me-1"></i>Admin</span>
      <a href="/admin/appointments" class="btn-admin-secondary ms-2">
        <i class="fas fa-arrow-left"></i> Back
      </a>
    </div>
  </div>

  <div class="admin-content">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
      <ol class="breadcrumb" style="font-size:13px;background:none;padding:0;margin:0;">
        <li class="breadcrumb-item"><a href="/admin" style="color:#0d9488;text-decoration:none;">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="/admin/appointments" style="color:#0d9488;text-decoration:none;">Appointments</a></li>
        <li class="breadcrumb-item active" style="color:#6b7280;">Create</li>
      </ol>
    </nav>

    <!-- Validation Errors -->
    <% if (errors && errors.length > 0) { %>
    <div class="alert alert-danger border-0 rounded-3 mb-4">
      <h6 class="mb-1"><i class="fas fa-exclamation-circle me-2"></i>Please fix the following:</h6>
      <ul class="mb-0 ps-3">
        <% errors.forEach(e => { %><li style="font-size:.88rem"><%= e %></li><% }) %>
      </ul>
    </div>
    <% } %>

    <form action="/admin/appointments/create" method="POST">
      <div class="row g-4">

        <!-- ── LEFT COLUMN ── -->
        <div class="col-xl-8">
          <div class="admin-form-card">
            <div class="admin-form-header">
              <h4><i class="fas fa-info-circle me-2"></i>Appointment Details</h4>
              <p>Fill in all required information for the appointment</p>
            </div>
            <div class="admin-form-body">
              <div class="row g-3">

                <!-- Patient -->
                <div class="col-md-12">
                  <div class="section-label">Patient Information</div>
                  <label class="form-label fw-semibold" for="patient">
                    <i class="fas fa-user me-1" style="color:#0d9488"></i>Select Patient
                    <span style="color:#ef4444">*</span>
                  </label>
                  <select id="patient" name="patient" class="form-select" required>
                    <option value="">— Choose a registered patient —</option>
                    <% patients.forEach(p => { %>
                    <option value="<%= p._id %>" <%= (formData.patient === p._id.toString()) ? 'selected' : '' %>>
                      <%= p.name %> &nbsp;(<%=  p.email %>)
                    </option>
                    <% }) %>
                  </select>
                  <div class="form-text text-muted" style="font-size:.76rem">
                    Only registered patients appear here.
                    <a href="/register" target="_blank" style="color:#0d9488;">Register new patient</a>
                  </div>
                </div>

                <!-- Doctor -->
                <div class="col-md-12">
                  <div class="section-label" style="margin-top:.5rem">Specialist</div>
                  <label class="form-label fw-semibold" for="doctor">
                    <i class="fas fa-stethoscope me-1" style="color:#0d9488"></i>Select Doctor
                    <span style="color:#ef4444">*</span>
                  </label>
                  <select id="doctor" name="doctor" class="form-select" required>
                    <option value="">— Choose a specialist —</option>
                    <% doctors.forEach(d => { %>
                    <option value="<%= d._id %>" <%= (formData.doctor === d._id.toString()) ? 'selected' : '' %>>
                      <%= d.name %> — <%= d.category %> (PKR <%= d.charges %>)
                    </option>
                    <% }) %>
                  </select>
                </div>

                <!-- Date & Time -->
                <div class="col-md-6">
                  <div class="section-label" style="margin-top:.5rem">Schedule</div>
                  <label class="form-label fw-semibold" for="appointmentDate">
                    <i class="fas fa-calendar me-1" style="color:#0d9488"></i>Appointment Date & Time
                    <span style="color:#ef4444">*</span>
                  </label>
                  <input type="datetime-local" id="appointmentDate" name="appointmentDate"
                         class="form-control"
                         value="<%= formData.appointmentDate || '' %>"
                         required>
                </div>

                <!-- Phone -->
                <div class="col-md-6">
                  <label class="form-label fw-semibold" for="phone" style="margin-top:1.6rem">
                    <i class="fas fa-phone me-1" style="color:#0d9488"></i>Contact Phone
                    <span style="color:#ef4444">*</span>
                  </label>
                  <input type="tel" id="phone" name="phone"
                         class="form-control"
                         value="<%= formData.phone || '' %>"
                         placeholder="+92 300 0000000"
                         required>
                </div>

                <!-- Symptoms -->
                <div class="col-md-12">
                  <div class="section-label" style="margin-top:.5rem">Medical Information</div>
                  <label class="form-label fw-semibold" for="symptoms">
                    <i class="fas fa-notes-medical me-1" style="color:#0d9488"></i>Symptoms / Reason for Visit
                    <span style="color:#ef4444">*</span>
                  </label>
                  <textarea id="symptoms" name="symptoms" class="form-control" rows="3"
                            placeholder="Describe the patient's symptoms or reason for the appointment..."
                            minlength="5" required><%= formData.symptoms || '' %></textarea>
                </div>

                <!-- Notes -->
                <div class="col-md-12">
                  <label class="form-label fw-semibold" for="notes">
                    <i class="fas fa-comment-medical me-1" style="color:#0d9488"></i>Admin Notes
                    <span class="text-muted fw-normal">(optional)</span>
                  </label>
                  <textarea id="notes" name="notes" class="form-control" rows="2"
                            placeholder="Internal notes — not visible to patient..."><%= formData.notes || '' %></textarea>
                </div>

              </div>
            </div>
          </div>
        </div>

        <!-- ── RIGHT COLUMN ── -->
        <div class="col-xl-4">
          <div class="admin-form-card" style="height:fit-content">
            <div class="admin-form-header">
              <h4><i class="fas fa-tasks me-2"></i>Status & Actions</h4>
              <p>Set the initial appointment status</p>
            </div>
            <div class="admin-form-body">

              <!-- Status -->
              <label class="form-label fw-semibold" for="status">
                <i class="fas fa-tag me-1" style="color:#0d9488"></i>Appointment Status
              </label>
              <select id="status" name="status" class="form-select mb-4">
                <option value="pending"   <%= (formData.status === 'pending'   || !formData.status) ? 'selected' : '' %>>⏳ Pending</option>
                <option value="approved"  <%= (formData.status === 'approved')  ? 'selected' : '' %>>✅ Approved</option>
                <option value="rejected"  <%= (formData.status === 'rejected')  ? 'selected' : '' %>>❌ Rejected</option>
                <option value="completed" <%= (formData.status === 'completed') ? 'selected' : '' %>>✔️ Completed</option>
                <option value="cancelled" <%= (formData.status === 'cancelled') ? 'selected' : '' %>>🚫 Cancelled</option>
              </select>

              <!-- Status Legend -->
              <div class="p-3 rounded-3 mb-4" style="background:#f8fafc;border:1px solid #e5e7eb;">
                <div class="section-label mb-2">Status Guide</div>
                <div class="small mb-1"><span class="badge" style="background:#fef3c7;color:#92400e">Pending</span> — Awaiting review</div>
                <div class="small mb-1"><span class="badge" style="background:#d1fae5;color:#065f46">Approved</span> — Confirmed by clinic</div>
                <div class="small mb-1"><span class="badge" style="background:#fee2e2;color:#991b1b">Rejected</span> — Declined</div>
                <div class="small mb-1"><span class="badge" style="background:#ccfbf1;color:#134e4a">Completed</span> — Visit done</div>
                <div class="small"><span class="badge" style="background:#f3f4f6;color:#374151">Cancelled</span> — Patient cancelled</div>
              </div>

              <!-- Submit -->
              <button type="submit" class="btn w-100 py-2 fw-semibold mb-2"
                      style="background:#0d9488;color:#fff;border-radius:8px;font-size:.95rem;">
                <i class="fas fa-calendar-plus me-2"></i>Create Appointment
              </button>
              <a href="/admin/appointments" class="btn btn-outline-secondary w-100 py-2 fw-semibold"
                 style="border-radius:8px;font-size:.9rem;">
                <i class="fas fa-times me-2"></i>Cancel
              </a>

            </div>
          </div>
        </div>

      </div>
    </form>

  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
  // Set min date to today on datetime-local input
  const dt = document.getElementById('appointmentDate');
  if (dt && !dt.value) {
    const now = new Date();
    now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
    dt.min = now.toISOString().slice(0, 16);
  }

  // Sidebar toggle
  document.getElementById('sidebarToggle')?.addEventListener('click', () => {
    document.querySelector('.admin-sidebar')?.classList.toggle('open');
    document.querySelector('.admin-main')?.classList.toggle('sidebar-open');
  });
</script>
</body>
</html>
