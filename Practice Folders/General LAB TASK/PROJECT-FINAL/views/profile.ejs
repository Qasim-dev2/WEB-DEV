<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Profile – Multisensa</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/navbar') %>
  <div class="container py-5">
    <%- include('partials/flash') %>
    <div class="row justify-content-center">
      <div class="col-12 col-md-8 col-lg-6">
        <div class="card border-0 shadow-lg">
          <div class="card-body text-center p-5">
            <!-- Avatar -->
            <div class="profile-avatar mx-auto mb-4">
              <%= currentUser.name.charAt(0).toUpperCase() %>
            </div>
            <h3 class="fw-bold mb-1"><%= currentUser.name %></h3>
            <p class="text-muted mb-3"><%= currentUser.email %></p>
            <% if (currentUser.role === 'admin') { %>
              <span class="badge bg-teal text-white px-3 py-2 rounded-pill mb-4">
                <i class="fa-solid fa-shield-halved me-1"></i>Administrator
              </span>
            <% } else { %>
              <span class="badge bg-secondary px-3 py-2 rounded-pill mb-4">
                <i class="fa-solid fa-user-injured me-1"></i>Patient
              </span>
            <% } %>
            <hr>
            <div class="text-start mt-3">
              <div class="d-flex justify-content-between py-2 border-bottom">
                <span class="text-muted"><i class="fa-solid fa-id-card me-2"></i>Full Name</span>
                <strong><%= currentUser.name %></strong>
              </div>
              <div class="d-flex justify-content-between py-2 border-bottom">
                <span class="text-muted"><i class="fa-solid fa-envelope me-2"></i>Email</span>
                <strong><%= currentUser.email %></strong>
              </div>
              <div class="d-flex justify-content-between py-2 border-bottom">
                <span class="text-muted"><i class="fa-solid fa-user-tag me-2"></i>Role</span>
                <strong class="text-capitalize"><%= currentUser.role %></strong>
              </div>
            </div>
            <div class="mt-4 d-flex gap-2 justify-content-center flex-wrap">
              <a href="/doctors" class="btn btn-teal px-4">
                <i class="fa-solid fa-user-doctor me-2"></i>View Specialists
              </a>
              <% if (currentUser.role === 'admin') { %>
              <a href="/admin" class="btn btn-outline-teal px-4">
                <i class="fa-solid fa-gauge-high me-2"></i>Admin Panel
              </a>
              <% } %>
              <a href="/logout" class="btn btn-outline-danger px-4">
                <i class="fa-solid fa-right-from-bracket me-2"></i>Logout
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
