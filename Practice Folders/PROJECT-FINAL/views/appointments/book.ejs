<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Book Appointment — Multisensa Rehabilitation</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body { font-family: 'Inter', sans-serif; background: #f8f9fa; }
    .booking-hero {
      background: linear-gradient(135deg, #0f766e 0%, #0d9488 60%, #14b8a6 100%);
      padding: 3rem 0 2rem;
      color: #fff;
    }
    .booking-card {
      border: none;
      border-radius: 16px;
      box-shadow: 0 10px 40px rgba(0,0,0,.1);
      overflow: hidden;
    }
    .booking-card .card-header {
      background: linear-gradient(135deg, #0f766e, #0d9488);
      color: #fff;
      padding: 1.5rem 2rem;
      border-bottom: none;
    }
    .form-label { font-weight: 600; color: #374151; font-size: .875rem; }
    .form-control, .form-select {
      border: 2px solid #e5e7eb;
      border-radius: 10px;
      padding: .65rem 1rem;
      font-size: .9rem;
      transition: border-color .2s, box-shadow .2s;
    }
    .form-control:focus, .form-select:focus {
      border-color: #0d9488;
      box-shadow: 0 0 0 3px rgba(13,148,136,.15);
    }
    .selected-doctor-card {
      background: linear-gradient(135deg, #f0fdfa, #e6fffa);
      border: 2px solid #99f6e4;
      border-radius: 12px;
      padding: 1rem 1.25rem;
    }
    .doctor-thumb {
      width: 56px; height: 56px;
      border-radius: 50%; object-fit: cover;
      border: 3px solid #0d9488;
    }
    .btn-book {
      background: linear-gradient(135deg, #0f766e, #0d9488);
      border: none; color: #fff;
      padding: .75rem 2.5rem;
      border-radius: 10px; font-weight: 600;
      font-size: 1rem; letter-spacing: .3px;
      transition: transform .15s, box-shadow .15s;
    }
    .btn-book:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(13,148,136,.4); color: #fff; }
    .step-badge {
      width: 32px; height: 32px; border-radius: 50%;
      background: #0d9488; color: #fff;
      display: inline-flex; align-items: center; justify-content: center;
      font-weight: 700; font-size: .85rem; flex-shrink: 0;
    }
    .info-tip { font-size: .8rem; color: #6b7280; margin-top: .25rem; }
  </style>
</head>
<body>

<%- include('../partials/navbar') %>

<!-- Hero -->
<section class="booking-hero">
  <div class="container">
    <div class="d-flex align-items-center gap-3 mb-2">
      <i class="fa-solid fa-calendar-plus fa-2x opacity-75"></i>
      <div>
        <h1 class="fw-bold mb-0" style="font-size:1.8rem">Book an Appointment</h1>
        <p class="mb-0 opacity-75">Choose your specialist and schedule a session</p>
      </div>
    </div>
    <nav aria-label="breadcrumb" class="mt-2">
      <ol class="breadcrumb mb-0" style="--bs-breadcrumb-divider-color:rgba(255,255,255,.5)">
        <li class="breadcrumb-item"><a href="/" class="text-white-50 text-decoration-none">Home</a></li>
        <li class="breadcrumb-item"><a href="/doctors" class="text-white-50 text-decoration-none">Specialists</a></li>
        <li class="breadcrumb-item active text-white">Book Appointment</li>
      </ol>
    </nav>
  </div>
</section>

<div class="container py-5">
  <%- include('../partials/flash') %>

  <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
  <div class="alert alert-danger rounded-3 mb-4" style="border-left:4px solid #dc2626">
    <div class="fw-semibold mb-1"><i class="fas fa-exclamation-circle me-2"></i>Please fix the following:</div>
    <ul class="mb-0 ps-3">
      <% errors.forEach(e => { %><li><%= e %></li><% }) %>
    </ul>
  </div>
  <% } %>

  <div class="row justify-content-center">
    <div class="col-lg-8">

      <div class="card booking-card">
        <div class="card-header">
          <h5 class="mb-1 fw-bold"><i class="fa-solid fa-notes-medical me-2"></i>Appointment Details</h5>
          <p class="mb-0 small opacity-75">Fill in all required fields to request your appointment</p>
        </div>

        <div class="card-body p-4">
          <form action="/appointments" method="POST">

            <!-- ── Doctor Selection ───────────────────────── -->
            <div class="d-flex align-items-start gap-3 mb-4">
              <span class="step-badge mt-1">1</span>
              <div class="flex-grow-1">
                <h6 class="fw-semibold mb-1">Choose a Specialist</h6>

                <% if (selectedDoctor) { %>
                <!-- Pre-selected doctor card -->
                <div class="selected-doctor-card mb-3">
                  <div class="d-flex align-items-center gap-3">
                    <% const img = selectedDoctor.image && selectedDoctor.image.trim()
                          ? (selectedDoctor.image.startsWith('http') ? selectedDoctor.image : '/uploads/doctors/' + selectedDoctor.image)
                          : 'https://ui-avatars.com/api/?name=' + encodeURIComponent(selectedDoctor.name) + '&background=0d9488&color=fff'; %>
                    <img src="<%= img %>" alt="<%= selectedDoctor.name %>" class="doctor-thumb"
                         onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(selectedDoctor.name) %>&background=0d9488&color=fff'">
                    <div>
                      <div class="fw-semibold text-teal"><%= selectedDoctor.name %></div>
                      <div class="text-muted small"><%= selectedDoctor.category %></div>
                      <div class="text-muted small">Rs. <%= selectedDoctor.charges %> / session</div>
                    </div>
                    <a href="/appointments/book" class="btn btn-sm btn-outline-secondary ms-auto">
                      <i class="fa-solid fa-repeat me-1"></i>Change
                    </a>
                  </div>
                </div>
                <input type="hidden" name="doctor" value="<%= selectedDoctor._id %>">

                <% } else { %>
                <!-- Dropdown when no pre-selected -->
                <select name="doctor" class="form-select" required>
                  <option value="">-- Select a specialist --</option>
                  <% doctors.forEach(doc => { %>
                  <option value="<%= doc._id %>" <%= (formData && formData.doctor == doc._id.toString()) ? 'selected' : '' %>>
                    <%= doc.name %> — <%= doc.category %> (Rs. <%= doc.charges %>)
                  </option>
                  <% }) %>
                </select>
                <div class="info-tip"><i class="fa-solid fa-circle-info me-1"></i>Only currently available specialists are shown.</div>
                <% } %>
              </div>
            </div>

            <hr class="my-3">

            <!-- ── Date & Time ────────────────────────────── -->
            <div class="d-flex align-items-start gap-3 mb-4">
              <span class="step-badge mt-1">2</span>
              <div class="flex-grow-1">
                <h6 class="fw-semibold mb-3">Select Date & Time</h6>
                <div class="row g-3">
                  <div class="col-md-6">
                    <label class="form-label">Preferred Date <span class="text-danger">*</span></label>
                    <input type="date" name="appointmentDate" class="form-control" required
                      min="<%= new Date().toISOString().split('T')[0] %>"
                      value="<%= formData && formData.appointmentDate ? formData.appointmentDate : '' %>">
                  </div>
                  <div class="col-md-6">
                    <label class="form-label">Preferred Time <span class="text-danger">*</span></label>
                    <select name="appointmentTime" class="form-select" required>
                      <option value="">-- Select time slot --</option>
                      <option value="09:00">09:00 AM</option>
                      <option value="09:30">09:30 AM</option>
                      <option value="10:00">10:00 AM</option>
                      <option value="10:30">10:30 AM</option>
                      <option value="11:00">11:00 AM</option>
                      <option value="11:30">11:30 AM</option>
                      <option value="12:00">12:00 PM</option>
                      <option value="14:00">02:00 PM</option>
                      <option value="14:30">02:30 PM</option>
                      <option value="15:00">03:00 PM</option>
                      <option value="15:30">03:30 PM</option>
                      <option value="16:00">04:00 PM</option>
                      <option value="16:30">04:30 PM</option>
                      <option value="17:00">05:00 PM</option>
                    </select>
                  </div>
                </div>
              </div>
            </div>

            <hr class="my-3">

            <!-- ── Contact & Symptoms ─────────────────────── -->
            <div class="d-flex align-items-start gap-3 mb-4">
              <span class="step-badge mt-1">3</span>
              <div class="flex-grow-1">
                <h6 class="fw-semibold mb-3">Contact & Symptoms</h6>
                <div class="mb-3">
                  <label class="form-label">Phone Number <span class="text-danger">*</span></label>
                  <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fa-solid fa-phone text-teal"></i></span>
                    <input type="tel" name="phone" class="form-control" placeholder="e.g. 0312-3456789"
                      value="<%= formData && formData.phone ? formData.phone : '' %>" required>
                  </div>
                  <div class="info-tip">We'll use this to confirm your appointment.</div>
                </div>

                <div class="mb-3">
                  <label class="form-label">Symptoms / Chief Complaint <span class="text-danger">*</span></label>
                  <textarea name="symptoms" class="form-control" rows="4" required
                    placeholder="Describe your main symptoms or reason for the appointment (minimum 5 characters)..." maxlength="1000"><%= formData && formData.symptoms ? formData.symptoms : '' %></textarea>
                  <div class="info-tip"><span id="sympLen">0</span>/1000 characters</div>
                </div>

                <div class="mb-3">
                  <label class="form-label">Additional Notes <span class="text-muted fw-normal">(optional)</span></label>
                  <textarea name="notes" class="form-control" rows="3"
                    placeholder="Any previous diagnoses, medications, or special requirements..." maxlength="500"><%= formData && formData.notes ? formData.notes : '' %></textarea>
                </div>
              </div>
            </div>

            <!-- ── Submit ─────────────────────────────────── -->
            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
              <a href="/doctors" class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left me-1"></i>Back to Specialists
              </a>
              <button type="submit" class="btn-book">
                <i class="fa-solid fa-paper-plane me-2"></i>Request Appointment
              </button>
            </div>

          </form>
        </div><!-- /.card-body -->
      </div><!-- /.card -->

      <!-- Info panel -->
      <div class="card border-0 shadow-sm mt-4 rounded-4">
        <div class="card-body p-4">
          <h6 class="fw-semibold mb-3"><i class="fa-solid fa-circle-info me-2 text-teal"></i>What happens next?</h6>
          <div class="row g-3">
            <div class="col-md-4 text-center">
              <div class="bg-teal-light rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width:48px;height:48px;background:#f0fdfa">
                <i class="fa-solid fa-paper-plane text-teal"></i>
              </div>
              <div class="small fw-semibold">Request Submitted</div>
              <div class="small text-muted">Your request is sent to our team</div>
            </div>
            <div class="col-md-4 text-center">
              <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width:48px;height:48px;background:#fffbeb">
                <i class="fa-solid fa-clock" style="color:#d97706"></i>
              </div>
              <div class="small fw-semibold">Under Review</div>
              <div class="small text-muted">Admin confirms availability</div>
            </div>
            <div class="col-md-4 text-center">
              <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width:48px;height:48px;background:#f0fdf4">
                <i class="fa-solid fa-check text-success"></i>
              </div>
              <div class="small fw-semibold">Appointment Confirmed</div>
              <div class="small text-muted">You'll see status in your dashboard</div>
            </div>
          </div>
        </div>
      </div>

    </div><!-- /.col -->
  </div><!-- /.row -->
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
  // Live character counter for symptoms
  const sympInput = document.querySelector('[name="symptoms"]');
  const sympLen   = document.getElementById('sympLen');
  if (sympInput && sympLen) {
    sympLen.textContent = sympInput.value.length;
    sympInput.addEventListener('input', () => { sympLen.textContent = sympInput.value.length; });
  }
</script>
</body>
</html>
