<script>
    // Auto-submit form when sort or category dropdowns change
    // This gives instant filtering UX without needing to click "Apply"
    var sortSel     = document.getElementById('sortSelect');
    var categorySel = document.getElementById('categorySelect');
    var filterForm  = document.getElementById('filterForm');

    if (sortSel)     sortSel.addEventListener('change',     function () { filterForm.submit(); });
    if (categorySel) categorySel.addEventListener('change', function () { filterForm.submit(); });
</script>

</body>
