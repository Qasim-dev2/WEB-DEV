<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login – Multisensa Rehab Center</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body class="auth-page">
  <%- include('../partials/navbar') %>

  <div class="auth-wrapper">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-7 col-lg-5">

          <%- include('../partials/flash') %>

          <div class="auth-card card border-0 shadow-lg">
            <div class="card-body p-4 p-md-5">
              <!-- Header -->
              <div class="text-center mb-4">
                <div class="auth-icon mb-3">
                  <i class="fa-solid fa-right-to-bracket"></i>
                </div>
                <h2 class="fw-bold mb-1">Welcome Back</h2>
                <p class="text-muted small">Sign in to your Multisensa account</p>
              </div>

              <!-- Inline errors -->
              <% if (errors && errors.length) { %>
              <div class="alert alert-danger border-0 small">
                <% errors.forEach(e => { %><div><i class="fa-solid fa-circle-exclamation me-1"></i><%= e %></div><% }) %>
              </div>
              <% } %>

              <form action="/login" method="POST" novalidate>
                <!-- Email -->
                <div class="mb-3">
                  <label class="form-label fw-semibold" for="email">Email Address</label>
                  <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-envelope text-muted"></i></span>
                    <input type="email" class="form-control border-start-0 ps-0" id="email" name="email"
                           placeholder="you@example.com"
                           value="<%= formData.email || '' %>" required>
                  </div>
                </div>

                <!-- Password -->
                <div class="mb-3">
                  <label class="form-label fw-semibold" for="password">Password</label>
                  <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-lock text-muted"></i></span>
                    <input type="password" class="form-control border-start-0 border-end-0 ps-0" id="password" name="password"
                           placeholder="Enter your password" required>
                    <button class="btn btn-outline-secondary border-start-0" type="button" id="togglePasswordBtn" title="Show/Hide password">
                      <i class="fa-solid fa-eye"></i>
                    </button>
                  </div>
                </div>

                <!-- Remember Me -->
                <div class="mb-4 d-flex justify-content-between align-items-center">
                  <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" id="rememberMe" name="rememberMe" value="1">
                    <label class="form-check-label text-muted small" for="rememberMe">Keep me logged in for 7 days</label>
                  </div>
                </div>

                <button type="submit" class="btn btn-teal w-100 py-2 fw-semibold">
                  <i class="fa-solid fa-right-to-bracket me-2"></i>Sign In
                </button>
              </form>

              <!-- Demo credentials -->
              <div class="mt-4 p-3 bg-light rounded-3 small">
                <div class="fw-semibold text-muted mb-1"><i class="fa-solid fa-circle-info me-1"></i>Demo Credentials</div>
                <div><span class="badge bg-teal me-1">Admin</span> admin@multisensa.com / Admin@123</div>
                <div class="mt-1"><span class="badge" style="background:#3b82f6;">Doctor</span> doctor@multisensa.com / Doctor@123</div>
                <div class="mt-1"><span class="badge bg-secondary me-1">Patient</span> patient@multisensa.com / Patient@123</div>
              </div>

              <hr class="my-4">
              <p class="text-center text-muted small mb-0">
                Don't have an account?
                <a href="/register" class="text-teal fw-semibold text-decoration-none">Create one &rarr;</a>
              </p>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/script.js"></script>
</body>
</html>
