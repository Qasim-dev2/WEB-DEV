<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Doctor — Multisensa Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="/css/admin.css" rel="stylesheet">
</head>
<body class="admin-body">

<%- include('partials/sidebar', { activePage: 'doctors' }) %>

<div class="admin-main">

    <!-- ── Top Bar ── -->
    <div class="admin-topbar">
        <div class="topbar-left">
            <button class="sidebar-toggle-btn" id="sidebarToggle">
                <i class="fas fa-bars"></i>
            </button>
            <div class="topbar-page-title">
                <h4><i class="fas fa-user-edit me-2" style="color:#0d9488;"></i>Edit Doctor</h4>
                <small>Update information for <%= doctor.name %></small>
            </div>
        </div>
        <div class="topbar-right">
            <span class="admin-role-badge"><i class="fas fa-shield-alt me-1"></i>Admin</span>
            <a href="/admin/doctors" class="btn-admin-secondary">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <div class="admin-content">

        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb" style="font-size:13px;background:none;padding:0;margin:0;">
                <li class="breadcrumb-item"><a href="/admin" style="color:#0d9488;text-decoration:none;">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="/admin/doctors" style="color:#0d9488;text-decoration:none;">Doctors</a></li>
                <li class="breadcrumb-item active" style="color:#6b7280;">Edit — <%= doctor.name %></li>
            </ol>
        </nav>

        <!-- ── Validation Errors ── -->
        <% if (errors && errors.length > 0) { %>
        <div class="errors-box mb-4">
            <h6><i class="fas fa-exclamation-circle"></i> Please fix the following errors:</h6>
            <ul>
                <% errors.forEach(err => { %>
                <li><%= err %></li>
                <% }) %>
            </ul>
        </div>
        <% } %>

        <!-- ── Edit Form ── -->
        <!--
            method-override: the form posts to /admin/doctors/:id?_method=PUT
            Express reads _method=PUT and treats it as a PUT request
        -->
        <form method="POST"
              action="/admin/doctors/<%= doctor._id %>?_method=PUT"
              enctype="multipart/form-data"
              id="editDoctorForm">

            <div class="row g-3">

                <!-- Left Column — Text Fields -->
                <div class="col-xl-8">
                    <div class="admin-form-card">
                        <div class="admin-form-header">
                            <h4><i class="fas fa-id-card me-2"></i>Doctor Information</h4>
                            <p>Update the specialist's details below</p>
                        </div>

                        <div class="admin-form-body">
                            <div class="row g-3">

                                <!-- Full Name -->
                                <div class="col-md-12">
                                    <label class="form-label" for="name">
                                        <i class="fas fa-user me-1" style="color:#0d9488;"></i>
                                        Full Name <span style="color:#ef4444;">*</span>
                                    </label>
                                    <input type="text"
                                           id="name"
                                           name="name"
                                           class="form-control"
                                           value="<%= doctor.name %>"
                                           placeholder="e.g. Dr. Ahmed Raza"
                                           required>
                                </div>

                                <!-- Qualification -->
                                <div class="col-md-12">
                                    <label class="form-label" for="qualification">
                                        <i class="fas fa-graduation-cap me-1" style="color:#0d9488;"></i>
                                        Qualification <span style="color:#ef4444;">*</span>
                                    </label>
                                    <input type="text"
                                           id="qualification"
                                           name="qualification"
                                           class="form-control"
                                           value="<%= doctor.qualification %>"
                                           placeholder="e.g. DPT, MSPT (UK)"
                                           required>
                                </div>

                                <!-- Category & Experience -->
                                <div class="col-md-6">
                                    <label class="form-label" for="category">
                                        <i class="fas fa-stethoscope me-1" style="color:#0d9488;"></i>
                                        Specialization <span style="color:#ef4444;">*</span>
                                    </label>
                                    <select id="category" name="category" class="form-select" required>
                                        <option value="">— Select Specialization —</option>
                                        <% categories.forEach(cat => { %>
                                        <option value="<%= cat %>"
                                                <%= doctor.category === cat ? 'selected' : '' %>>
                                            <%= cat %>
                                        </option>
                                        <% }) %>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label" for="experience">
                                        <i class="fas fa-briefcase me-1" style="color:#0d9488;"></i>
                                        Years of Experience
                                    </label>
                                    <input type="number"
                                           id="experience"
                                           name="experience"
                                           class="form-control"
                                           value="<%= doctor.experience %>"
                                           placeholder="e.g. 8"
                                           min="0"
                                           max="60">
                                </div>

                                <!-- Charges & Rating -->
                                <div class="col-md-6">
                                    <label class="form-label" for="charges">
                                        <i class="fas fa-money-bill-wave me-1" style="color:#0d9488;"></i>
                                        Consultation Charges (PKR) <span style="color:#ef4444;">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text" style="background:#f9fafb;border:1.5px solid #e5e7eb;border-right:none;border-radius:8px 0 0 8px;font-size:13px;font-weight:600;color:#6b7280;">PKR</span>
                                        <input type="number"
                                               id="charges"
                                               name="charges"
                                               class="form-control"
                                               value="<%= doctor.charges %>"
                                               placeholder="e.g. 2500"
                                               min="0"
                                               required
                                               style="border-left:none;border-radius:0 8px 8px 0;">
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label" for="rating">
                                        <i class="fas fa-star me-1" style="color:#f59e0b;"></i>
                                        Patient Rating (1–5)
                                    </label>
                                    <input type="number"
                                           id="rating"
                                           name="rating"
                                           class="form-control"
                                           value="<%= doctor.rating %>"
                                           placeholder="e.g. 4.5"
                                           min="1"
                                           max="5"
                                           step="0.1">
                                </div>

                                <!-- Availability -->
                                <div class="col-md-12">
                                    <label class="form-label" for="availability">
                                        <i class="fas fa-calendar-check me-1" style="color:#0d9488;"></i>
                                        Appointment Availability
                                    </label>
                                    <select id="availability" name="availability" class="form-select">
                                        <option value="Available"
                                                <%= doctor.availability === 'Available' ? 'selected' : '' %>>
                                            ✅ Available
                                        </option>
                                        <option value="Limited Slots"
                                                <%= doctor.availability === 'Limited Slots' ? 'selected' : '' %>>
                                            ⚠️ Limited Slots
                                        </option>
                                        <option value="Fully Booked"
                                                <%= doctor.availability === 'Fully Booked' ? 'selected' : '' %>>
                                            ❌ Fully Booked
                                        </option>
                                    </select>
                                </div>

                                <!-- Description -->
                                <div class="col-md-12">
                                    <label class="form-label" for="description">
                                        <i class="fas fa-align-left me-1" style="color:#0d9488;"></i>
                                        Bio / Description <span style="color:#ef4444;">*</span>
                                    </label>
                                    <textarea id="description"
                                              name="description"
                                              class="form-control"
                                              rows="4"
                                              required><%= doctor.description %></textarea>
                                </div>

                            </div><!-- /row -->
                        </div><!-- /admin-form-body -->
                    </div><!-- /admin-form-card -->
                </div><!-- /col-xl-8 -->

                <!-- Right Column — Image -->
                <div class="col-xl-4">
                    <div class="admin-form-card" style="height:fit-content;">
                        <div class="admin-form-header">
                            <h4><i class="fas fa-image me-2"></i>Profile Photo</h4>
                            <p>Upload a new photo to replace the current one</p>
                        </div>
                        <div class="admin-form-body">

                            <!-- Current Image Preview -->
                            <div style="margin-bottom:14px;">
                                <p style="font-size:12px;font-weight:700;color:#374151;margin-bottom:8px;">Current Photo</p>
                                <div style="width:100%;height:140px;border-radius:10px;overflow:hidden;border:2px solid #e5e7eb;background:#f9fafb;display:flex;align-items:center;justify-content:center;">
                                    <img id="currentImage"
                                         src="<%= doctor.image || `https://ui-avatars.com/api/?name=${encodeURIComponent(doctor.name)}&background=0d9488&color=fff&size=200&bold=true&rounded=true` %>"
                                         alt="<%= doctor.name %>"
                                         style="max-width:100%;max-height:100%;object-fit:contain;"
                                         onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(doctor.name) %>&background=0d9488&color=fff&size=200&bold=true&rounded=true'">
                                </div>
                            </div>

                            <!-- Upload New Image -->
                            <div class="upload-zone" id="uploadZone">
                                <input type="file"
                                       id="imageInput"
                                       name="image"
                                       accept="image/jpeg,image/jpg,image/png,image/webp">
                                <img id="imagePreview" src="" alt="New Preview" style="display:none;max-width:100%;max-height:130px;object-fit:contain;border-radius:8px;">
                                <div class="upload-placeholder" id="uploadPlaceholder">
                                    <i class="fas fa-cloud-upload-alt"></i>
                                    <p><span>Click to upload new photo</span></p>
                                    <p style="font-size:11px;margin-top:4px;">JPG, PNG, WEBP — Max 5 MB</p>
                                </div>
                            </div>

                            <p class="mt-2 mb-0" style="font-size:12px;color:#9ca3af;text-align:center;">
                                <i class="fas fa-info-circle me-1"></i>
                                Leave empty to keep the current photo
                            </p>

                        </div>
                    </div><!-- /admin-form-card -->

                    <!-- Form Actions -->
                    <div style="margin-top:16px;display:flex;flex-direction:column;gap:10px;">
                        <button type="submit" class="btn-admin-primary" style="width:100%;justify-content:center;padding:13px;">
                            <i class="fas fa-save"></i> Update Doctor
                        </button>
                        <a href="/admin/doctors" class="btn-admin-secondary" style="width:100%;justify-content:center;padding:13px;">
                            <i class="fas fa-times"></i> Cancel
                        </a>
                    </div>

                    <!-- Danger Zone -->
                    <div style="margin-top:16px;background:#fef2f2;border:1px solid #fecaca;border-radius:10px;padding:16px;">
                        <p style="font-size:12px;font-weight:700;color:#dc2626;margin:0 0 10px;">
                            <i class="fas fa-exclamation-triangle me-1"></i> Danger Zone
                        </p>
                        <button type="button"
                                class="btn-action btn-delete w-100 justify-content-center"
                                style="padding:9px;"
                                onclick="confirmDelete('<%= doctor._id %>', '<%= doctor.name.replace(/'/g, `\\'`) %>')">
                            <i class="fas fa-trash-alt"></i> Delete This Doctor
                        </button>
                        <form id="deleteForm-<%= doctor._id %>"
                              action="/admin/doctors/<%= doctor._id %>?_method=DELETE"
                              method="POST"
                              style="display:none;"></form>
                    </div>

                </div><!-- /col-xl-4 -->

            </div><!-- /row -->

        </form>

    </div><!-- /admin-content -->
</div><!-- /admin-main -->

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header modal-header-danger">
                <h5 class="modal-title">
                    <i class="fas fa-exclamation-triangle me-2"></i>Confirm Deletion
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center" style="padding:28px;">
                <div style="width:64px;height:64px;background:#fee2e2;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
                    <i class="fas fa-user-minus" style="font-size:28px;color:#dc2626;"></i>
                </div>
                <h5 style="color:#1f2937;font-weight:700;margin-bottom:8px;">Remove Doctor?</h5>
                <p style="color:#6b7280;font-size:14px;margin:0;">
                    Are you sure you want to permanently remove
                    <strong id="deleteDoctorName" style="color:#1f2937;"></strong>?
                </p>
                <p style="color:#ef4444;font-size:13px;margin-top:8px;">
                    <i class="fas fa-exclamation-circle me-1"></i>This action cannot be undone.
                </p>
            </div>
            <div class="modal-footer" style="border:none;padding:0 28px 24px;gap:10px;">
                <button type="button" class="btn-admin-secondary flex-grow-1" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <button type="button"
                        class="btn-admin-primary flex-grow-1"
                        style="background:#dc2626;"
                        onclick="submitDelete()">
                    <i class="fas fa-trash-alt"></i> Yes, Remove
                </button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // ── Mobile Sidebar ────────────────────────────────────
    const toggleBtn = document.getElementById('sidebarToggle');
    const sidebar   = document.getElementById('adminSidebar');
    const overlay   = document.getElementById('sidebarOverlay');

    toggleBtn?.addEventListener('click', () => {
        sidebar.classList.toggle('open');
        overlay.classList.toggle('active');
    });
    overlay?.addEventListener('click', () => {
        sidebar.classList.remove('open');
        overlay.classList.remove('active');
    });

    // ── Image Preview ─────────────────────────────────────
    const imageInput        = document.getElementById('imageInput');
    const imagePreview      = document.getElementById('imagePreview');
    const uploadPlaceholder = document.getElementById('uploadPlaceholder');
    const uploadZone        = document.getElementById('uploadZone');

    imageInput.addEventListener('change', function () {
        const file = this.files[0];
        if (!file) return;

        if (file.size > 5 * 1024 * 1024) {
            alert('File too large! Maximum allowed size is 5 MB.');
            this.value = '';
            return;
        }

        const reader = new FileReader();
        reader.onload = (e) => {
            imagePreview.src = e.target.result;
            imagePreview.style.display = 'block';
            uploadPlaceholder.style.display = 'none';
            uploadZone.classList.add('has-image');
        };
        reader.readAsDataURL(file);
    });

    // ── Delete Modal ──────────────────────────────────────
    let deleteId = null;

    function confirmDelete(id, name) {
        deleteId = id;
        document.getElementById('deleteDoctorName').textContent = name;
        new bootstrap.Modal(document.getElementById('deleteModal')).show();
    }

    function submitDelete() {
        if (deleteId) {
            document.getElementById(`deleteForm-${deleteId}`).submit();
        }
    }

    // ── Submit Loader ─────────────────────────────────────
    document.getElementById('editDoctorForm').addEventListener('submit', function () {
        const btn = this.querySelector('button[type="submit"]');
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
        btn.disabled = true;
    });
</script>

</body>
</html>
